{
  "name": "settlement-fuji-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "chain:compile": "bun scripts/compile.ts",
    "chain:local": "bun scripts/local-chain.ts",
    "verify": "bun run typecheck && bun test",
    "demo:orders": "bun scripts/order-demo.ts",
    "demo:agent-pay": "bun scripts/agent-pay-demo.ts",
    "verify:orders": "bun scripts/verify-order-demo.ts",
    "build:web": "bun scripts/build-web.ts",
    "build:web:e2e": "bun scripts/build-web.ts --e2e",
    "dev:wallet-signer": "bun scripts/dev-wallet-signer.ts",
    "dev:web": "cd web && bun run dev",
    "dev:worker": "wrangler dev --local",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "viem": "2.47.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@types/bun": "1.3.10",
    "@x402/core": "2.26.0",
    "@x402/evm": "2.26.0",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "typescript": "5.9.3",
    "wrangler": "4.143.0"
  }
}
